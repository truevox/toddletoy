{
  "name": "toddler-toy-pwa",
  "version": "2.1.1",
  "description": "Montessori-aligned interactive toddler toy PWA",
  "main": "index.html",
  "scripts": {
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
    "test:e2e:ci": "playwright test --project=chromium --project=\"Mobile Chrome\"",
    "test:performance": "playwright test tests/browser/performance-validation.spec.js",
    "test:all": "npm run test && npm run test:e2e",
    "prepare": "husky install",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/"
  },
  "dependencies": {
    "phaser": "^3.70.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@playwright/test": "^1.53.1",
    "babel-jest": "^30.0.4",
    "eslint": "^8.0.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.20.5"
  },
  "keywords": [
    "pwa",
    "toddler",
    "montessori",
    "educational",
    "interactive"
  ],
  "author": "Marvin Bentley II",
  "license": "MIT"
}
